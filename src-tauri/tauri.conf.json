{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteVault",
  "version": "0.1.0",
  "identifier": "com.notevault.app",
  "build": {
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteVault · 笔记查看器",
